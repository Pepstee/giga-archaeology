{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga.local/contracts/retrospective-capability-candidates.v2.schema.json",
  "title": "GIGA retrospective capability candidate feed v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "inventory_manifest_sha256", "generated_at", "candidates", "self_sha256"],
  "properties": {
    "schema": {"const": "giga.retrospective-capability-candidates.v2"},
    "producer": {"type": "string", "minLength": 1},
    "inventory_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "self_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$)).+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "consumer_head_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"const": "consumer-head-file"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "git_object_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo_alias", "commit", "tree", "path", "git_blob_oid", "sha256", "bytes", "source_status"],
      "properties": {
        "kind": {"const": "git-object-file"},
        "repo_alias": {"const": "giga-user"},
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"},
        "path": {"$ref": "#/$defs/path"},
        "git_blob_oid": {"$ref": "#/$defs/git_oid"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "source_status": {"enum": ["TRACKED_CLEAN_HEAD", "TRACKED_REVIEWED_HISTORY"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "capability_id", "disposition", "owner_hint", "source_refs", "entrypoint_hints", "reason"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "capability_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["DORMANT_ADOPTABLE", "DISCONNECTED", "DUPLICATED", "BROKEN", "OBSOLETE"]},
        "owner_hint": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"oneOf": [{"$ref": "#/$defs/consumer_head_file"}, {"$ref": "#/$defs/git_object_file"}]}
        },
        "entrypoint_hints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
