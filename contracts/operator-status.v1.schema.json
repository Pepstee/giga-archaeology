{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga-user.local/contracts/operator-status.v1.schema.json",
  "title": "GIGA read-only operator status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "observed_at", "sections", "summary"],
  "properties": {
    "schema_version": {"const": "giga.operator-status.v1"},
    "authority": {"const": "read-only-status"},
    "observed_at": {"type": "string", "format": "date-time"},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "toolCalls", "activeAgents", "todos", "checks", "cost", "risk", "queueState", "sessionControls", "sync"],
      "properties": {
        "context": {"$ref": "#/$defs/envelope"},
        "toolCalls": {"$ref": "#/$defs/envelope"},
        "activeAgents": {"$ref": "#/$defs/envelope"},
        "todos": {"$ref": "#/$defs/envelope"},
        "checks": {"$ref": "#/$defs/envelope"},
        "cost": {"$ref": "#/$defs/envelope"},
        "risk": {"$ref": "#/$defs/envelope"},
        "queueState": {"$ref": "#/$defs/envelope"},
        "sessionControls": {"$ref": "#/$defs/envelope"},
        "sync": {"$ref": "#/$defs/envelope"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_state", "state_counts"],
      "properties": {
        "overall_state": {"$ref": "#/$defs/state"},
        "state_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "healthy", "degraded", "blocked", "unknown", "unavailable", "stale"],
          "properties": {
            "observed": {"type": "integer", "minimum": 0},
            "healthy": {"type": "integer", "minimum": 0},
            "degraded": {"type": "integer", "minimum": 0},
            "blocked": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "unavailable": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "state": {"enum": ["observed", "healthy", "degraded", "blocked", "unknown", "unavailable", "stale"]},
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "state", "source", "observed_at"],
      "properties": {
        "value": true,
        "state": {"$ref": "#/$defs/state"},
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
