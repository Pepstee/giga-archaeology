+def test_factory_codex_auth_rotation_is_reused_without_overwriting_from_operator(
+    tmp_path, monkeypatch,
+):
+    source_home = tmp_path / "operator-codex-home"
+    source_home.mkdir()
+    source_auth = source_home / "auth.json"
+    source_auth.write_text('{"token":"operator-original"}', encoding="utf-8")
+    monkeypatch.setenv("CODEX_HOME", str(source_home))

+    first, seen = _inspection(tmp_path, monkeypatch, ["llm:openai"])
+    assert first.ok is True
+    factory_auth = Path(seen["codex_home"]) / "auth.json"
+    factory_auth.write_text('{"token":"factory-rotated"}', encoding="utf-8")
+    source_auth.write_text('{"token":"operator-changed"}', encoding="utf-8")

+    second, seen_again = _inspection(tmp_path, monkeypatch, ["llm:openai"])
+    assert second.ok is True
+    assert Path(seen_again["codex_home"]) == factory_auth.parent
+    assert factory_auth.read_text(encoding="utf-8") == '{"token":"factory-rotated"}'
+    assert source_auth.read_text(encoding="utf-8") == '{"token":"operator-changed"}'
+
