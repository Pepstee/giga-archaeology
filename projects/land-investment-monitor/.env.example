# Optional semantic analysis. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional Telegram delivery/control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live collection is opt-in and must comply with each source's Terms and robots.txt.
LAND_MONITOR_ALLOW_LIVE_SCRAPING=false

# Optional proxy owned/authorized by the operator.
HTTPS_PROXY=
