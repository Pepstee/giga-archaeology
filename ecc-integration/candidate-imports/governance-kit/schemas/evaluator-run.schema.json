{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giga.local/schemas/evaluator-run.v1.json",
  "title": "Read-only evaluator promotion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "trace", "report", "candidates", "verifier", "rollback", "promoted"],
  "properties": {
    "scenario": {"type": "string", "minLength": 1},
    "trace": {"type": "string", "minLength": 1},
    "report": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["accepted", "rejected"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "verifier": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "promoted": {"type": "boolean"}
  }
}
