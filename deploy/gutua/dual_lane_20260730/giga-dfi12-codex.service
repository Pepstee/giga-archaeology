[Unit]
Description=GIGA concurrent DFI-12 Codex supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/gutua/software-factory/.worktrees/orchestrator-v3-dfi-12
Environment=PATH=/home/gutua/software-factory/.control/native-dual-lane-20260726/bin:/home/gutua/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLAUDE_LOCK_TIMEOUT_SECONDS=7200
Environment=DFI12_TOTAL_SECONDS=86400
ExecStart=/home/gutua/software-factory/giga-user/deploy/gutua/dual_lane_20260730/run_dfi12_codex_supervisor.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
KillMode=mixed
Nice=5

[Install]
