#!/bin/sh
# Non-blocking GIGA navigation refresh after a committed milestone.
GIGA_NAV_ROOT=$(/usr/bin/git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ "$GIGA_NAV_ROOT" = "/Users/admin/Documents/giga-user" ] || exit 0
mkdir -p /Users/admin/.jarvis/navigation
# launchd, rather than the short-lived Git process, owns the refresh lifecycle.
/bin/launchctl kickstart "gui/$(/usr/bin/id -u)/com.artiom.giga-navigation-maintenance" \
  >>/Users/admin/.jarvis/navigation/post-commit.out \
  2>>/Users/admin/.jarvis/navigation/post-commit.err || true
exit 0
